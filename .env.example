# TMDB API key - get a free one at https://www.themoviedb.org/settings/api
# Use the "API Key (v3 auth)" value here.
TMDB_API_KEY=

# Alternatively use a TMDB v4 read access token (leave empty if using the key above).
TMDB_ACCESS_TOKEN=

# Where review data is written. Point this at a mounted volume in Docker.
DATA_DIR=./data

# Public site name shown in the header.
NEXT_PUBLIC_SITE_NAME=CineVault
